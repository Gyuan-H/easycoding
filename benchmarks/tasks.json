    "scripted_outputs": [
      "<tool>{\"name\":\"run_shell\",\"args\":{\"command\":\"python -c \\\"from pathlib import Path; Path('changed.txt').write_text('changed', encoding='utf-8'); raise SystemExit(1)\\\"\"}}</tool>",
